# Copiar mediante npm run setup. No subir .env ni claves a Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
FIREBASE_PROJECT_ID=demo-ciudad-conecta
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
ADMIN_USER=municipal
# npm run setup genera el hash y el secreto de sesión.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# En la nube: quitar FIRESTORE_EMULATOR_HOST, cambiar el ID y configurar
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/service-account.json
# NODE_ENV=production requiere HTTPS y cookie Secure.
# Render: usar variables del panel, no este archivo ni FIRESTORE_EMULATOR_HOST.
# FIREBASE_SERVICE_ACCOUNT_JSON: JSON completo de la cuenta de servicio, como secreto.
# ADMIN_PASSWORD: contraseña de 12 a 200 caracteres (alternativa a ADMIN_PASSWORD_HASH).
# Render proporciona PORT y RENDER_EXTERNAL_URL automáticamente.
