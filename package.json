{
  "name": "ciudad-conecta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal ciudadano y panel municipal — Series I y II",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview:frontend": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file=.env backend/server.js",
    "test": "node --test tests/unit.test.js",
    "test:integration": "node --env-file=.env --test tests/integration.test.js",
    "test:ui": "node --env-file=.env tests/browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "firebase-tools": "^14.26.0",
    "playwright": "^1.56.1"
  }
}
